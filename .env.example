# Configuração do Servidor MCP Calima-Manus
# 
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA compartilhe ou versione o arquivo .env com credenciais reais

# Credenciais de acesso ao Calima ERP
# Pode ser: usuário, CPF, e-mail, código de cliente ou CNPJ
CALIMA_USERNAME=seu_usuario_aqui

# Senha de acesso ao Calima ERP
CALIMA_PASSWORD=sua_senha_aqui

# Opcional: Timeout para operações (em milissegundos)
# CALIMA_TIMEOUT=30000

# Opcional: Modo headless do navegador (true/false)
# CALIMA_HEADLESS=true
